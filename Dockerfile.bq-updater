# building:
# tag_version="1.0.4"
# docker buildx build \
#    --platform linux/amd64,linux/arm64 \
#    --tag code.blockchain-applied.com/bca/cardano-bq-updater:latest \
#    --tag code.blockchain-applied.com/bca/cardano-bq-updater:${tag_version} \
#    --push \
#    -f Dockerfile.bq-updater .

FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        jq \
        postgresql-client \
        sed \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/scripts

COPY scripts/ /app/scripts/
COPY schema/tables/ /app/schema/tables/

RUN mkdir -p /app/scripts/logs \
    && find /app/scripts -maxdepth 1 -type f -name "*.sh" -exec chmod +x {} \;

ENTRYPOINT ["bash", "-lc"]
CMD ["./run_bq_update.sh"]
